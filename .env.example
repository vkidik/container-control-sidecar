# One image published by .github/workflows/publish-images.yml.
GHCR_REGISTRY=ghcr.io
GHCR_REPOSITORY=your-github-user/container-control-sidecar
IMAGE_TAG=latest

# Exact address used to open the owner panel in a browser. The WebAuthn RP ID
# is derived automatically from this URL's hostname.
WEBAUTHN_ORIGIN=http://localhost:8787
BOOTSTRAP_TOKEN=replace-with-a-long-random-one-time-token

# Linux only: group that owns /var/run/docker.sock on an agent host.
DOCKER_GID=999
